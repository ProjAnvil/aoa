# One shared env file for every compose group under examples/.
# run.sh copies this to examples/.env on first use. Edit .env, not this file.
# Do not scatter .env files into examples/<name>/: all groups share the same
# model, proxy, and log settings. Group-specific values stay in compose.yaml.

# aoa event examples. offline = deterministic scripted model, no LLM call.
# Switch to ollama:qwen2.5:0.5b to run the real langchain-golang agent.
AOA_MODEL=offline
# AOA_MODEL=ollama:qwen2.5:0.5b

# examples/langchain-golang uses its own key. It always runs the real model
# even when the seven event examples stay on the offline scripted model.
AOA_LANGGOLANG_MODEL=ollama:qwen2.5:0.5b

# Model pulled into aoa_shared_ollama_models and used by `hello` / `agent-hello`.
OLLAMA_MODEL=qwen2.5:0.5b

# Structured logging for the aoad service.
AOA_LOG_FORMAT=text
AOA_LOG_LEVEL=info

# SafeProxy requires a non-empty token. This is an example placeholder.
AOA_PROXY_TOKEN=example-token

# Empty in examples. Production must set it: HMAC then covers method, path,
# timestamp, and body on /events and /approvals.
AOA_SIGNATURE_KEY=

# Optional. run.sh derives this from HTTPS_PROXY / HTTP_PROXY by rewriting
# 127.0.0.1 -> host.docker.internal for OrbStack containers.
# AOA_EXAMPLE_PROXY=http://host.docker.internal:63967
